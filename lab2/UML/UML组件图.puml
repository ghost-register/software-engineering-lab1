@startuml
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 17
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #475569
skinparam classBackgroundColor #F1F5F9
skinparam classBorderColor #64748B
skinparam componentBackgroundColor #EFF6FF
skinparam componentBorderColor #64748B
title 单体分层架构与模块交互
top to bottom direction
skinparam linetype ortho
rectangle "表现层" {
 component "普通用户网页\n发布、查询、预约" as Web
 component "管理员后台\n审核、处置、统计" as Admin
 Web -[hidden]right- Admin
}
component "接口与访问控制\n校验身份、角色、对象归属" as API
rectangle "应用层 同一进程与事务管理器" {
 component "商品模块" as Catalog
 component "交易模块" as Trade
 component "治理模块" as Gov
 component "统计模块" as Stats
 component "日志模块" as Audit
 Catalog -[hidden]right- Trade
 Trade -[hidden]right- Gov
 Stats -[hidden]right- Audit
 Trade --> Catalog : 检查商品状态
 Gov --> Trade : 关闭有效预约
 Trade --> Audit : 操作结果
 Gov --> Audit : 处置结果
}
component "数据访问层\nRepository + 同一事务连接" as DAO
database "PostgreSQL 16+\n账号、商品、预约、治理、日志" as DB
folder "图片文件存储\n随机键、类型与大小校验" as Img
Web --> API
Admin --> API
API --> Catalog
API --> Trade
API --> Gov
API --> Stats
Catalog --> DAO
Trade --> DAO
Gov --> DAO
Stats --> DAO
Audit --> DAO
DAO --> DB
Catalog --> Img
note bottom of DB
商品锁顺序固定；成功日志与业务一起提交。
拒绝或回滚后的失败日志另起事务保存。
模块调用不是跨服务网络调用。
end note
@enduml
